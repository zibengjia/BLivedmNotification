<ui:FluentWindow x:Class="Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="BLivedm Notification"
        MinWidth="720" MinHeight="600"
        Width="760" Height="660"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Closing="OnClosing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════ Title Bar ══════════ -->
        <ui:TitleBar Grid.Row="0" Title="BLivedm Notification" />

        <!-- ══════════ Tab Control (config) ══════════ -->
        <TabControl Grid.Row="1" Margin="8,0,8,4">
            <!-- ── Tab 1: 基本设置 ── -->
            <TabItem Header="基本设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <ui:Card Margin="0,0,0,0" Padding="12">
                            <StackPanel>
                                <TextBlock Text="连接设置" FontWeight="SemiBold" Margin="0,0,0,8" />

                                <!-- Pipe Name -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Pipe 名称：" VerticalAlignment="Center" />
                                    <TextBox x:Name="PipeNameBox" Grid.Column="1" Text="BlivedmOverlay" />
                                </Grid>

                                <!-- SESSDATA -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SESSDATA：" VerticalAlignment="Center" />
                                    <PasswordBox x:Name="SessdataBox" Grid.Column="1" />
                                    <CheckBox x:Name="ShowSessdataCheck" Grid.Column="2"
                                              Content="显示" Margin="4,0,0,0"
                                              VerticalAlignment="Center"
                                              Checked="OnShowSessdata" Unchecked="OnShowSessdata" />
                                </Grid>

                                <!-- Display -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="显示器：" VerticalAlignment="Center" />
                                    <ComboBox x:Name="DisplayCombo" Grid.Column="1" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="12">
                            <StackPanel>
                                <TextBlock Text="Python 设置" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Python 路径：" VerticalAlignment="Center" />
                                    <TextBox x:Name="PythonPathBox" Grid.Column="1" Text="python" />
                                    <ui:Button Grid.Column="2" Content="浏览"
                                               Icon="{ui:SymbolIcon FolderOpen24}" Margin="4,0,0,0"
                                               Click="OnBrowsePython" />
                                </Grid>
                                <TextBlock TextWrapping="Wrap"
                                           Text="提示：用于运行 py_overlay/main.py（B站弹幕后端）。留空则自动检测：项目 .venv → uv.exe → 系统 PATH 中的 python。指定路径可固定使用特定环境（如 pyenv、conda）。修改后需点击「保存配置」。"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 2: 房间 ── -->
            <TabItem Header="房间">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <ui:Card Padding="12">
                            <StackPanel>
                                <TextBlock Text="房间列表" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ListBox x:Name="RoomListBox" Height="150"
                                         SelectionChanged="OnRoomSelectionChanged" />
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:NumberBox x:Name="NewRoomIdBox" Grid.Column="0"
                                                  PlaceholderText="输入房间号添加" Minimum="1" Maximum="99999999" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
                                        <ui:Button Content="添加" Click="OnAddRoom" />
                                        <ui:Button Content="获取名称" Click="OnFetchRoomName" Margin="4,0" Appearance="Secondary" />
                                        <ui:Button Content="删除" Click="OnRemoveRoom" Appearance="Danger" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="提示：点击列表中的房间可切换弹幕来源。切换后后端会自动重启。"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="11" Margin="0,2,0,4" />
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="12">
                            <StackPanel>
                                <TextBlock Text="房间备注" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="备注名：" VerticalAlignment="Center" />
                                    <TextBox x:Name="RoomLabelBox" Grid.Column="1" Text="" />
                                    <ui:Button Grid.Column="2" Content="保存备注" Margin="4,0,0,0"
                                               Click="OnSaveRoomLabel" />
                                </Grid>
                                <TextBlock Text="可自定义房间显示名称。点击「获取名称」自动从 B站 拉取主播名填入。"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 3: 弹幕设置 ── -->
            <TabItem Header="弹幕设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <!-- Text Settings -->
                        <ui:Card Padding="12">
                            <StackPanel>
                                <TextBlock Text="文字设置" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="字号：" VerticalAlignment="Center" />
                                    <Slider x:Name="FontSizeSlider" Grid.Column="1"
                                            Minimum="12" Maximum="48" TickFrequency="1"
                                            ValueChanged="OnDanmakuPreviewChanged" />
                                    <TextBlock x:Name="FontSizeLabel" Grid.Column="2"
                                               Text="21" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="字体粗细：" VerticalAlignment="Center" />
                                    <ComboBox x:Name="FontWeightCombo" Grid.Column="1">
                                        <ComboBoxItem>Normal</ComboBoxItem>
                                        <ComboBoxItem>Light</ComboBoxItem>
                                        <ComboBoxItem>Medium</ComboBoxItem>
                                        <ComboBoxItem>SemiBold</ComboBoxItem>
                                        <ComboBoxItem>Bold</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="速度：" VerticalAlignment="Center" />
                                    <Slider x:Name="SpeedSlider" Grid.Column="1"
                                            Minimum="50" Maximum="500" TickFrequency="10"
                                            ValueChanged="OnDanmakuPreviewChanged" />
                                    <TextBlock x:Name="SpeedLabel" Grid.Column="2"
                                               Text="300" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="不透明度：" VerticalAlignment="Center" />
                                    <Slider x:Name="OpacitySlider" Grid.Column="1"
                                            Minimum="0.1" Maximum="1.0" TickFrequency="0.05"
                                            ValueChanged="OnDanmakuPreviewChanged" />
                                    <TextBlock x:Name="OpacityLabel" Grid.Column="2"
                                               Text="0.90" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Track Settings -->
                        <ui:Card Padding="12">
                            <StackPanel>
                                <TextBlock Text="轨道设置" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="轨道数：" VerticalAlignment="Center" />
                                    <Slider x:Name="TrackCountSlider" Grid.Column="1"
                                            Minimum="4" Maximum="24" TickFrequency="1"
                                            ValueChanged="OnDanmakuPreviewChanged" />
                                    <TextBlock x:Name="TrackCountLabel" Grid.Column="2"
                                               Text="12" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="出现位置：" VerticalAlignment="Center" />
                                    <ComboBox x:Name="PositionPriorityCombo" Grid.Column="1"
                                              SelectedIndex="0">
                                        <ComboBoxItem>Top</ComboBoxItem>
                                        <ComboBoxItem>Center</ComboBoxItem>
                                        <ComboBoxItem>Bottom</ComboBoxItem>
                                    </ComboBox>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="弹幕密度：" VerticalAlignment="Center" />
                                    <ComboBox x:Name="DensityCombo" Grid.Column="1"
                                              SelectedIndex="1">
                                        <ComboBoxItem>Low</ComboBoxItem>
                                        <ComboBoxItem>Medium</ComboBoxItem>
                                        <ComboBoxItem>High</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Shadow Settings -->
                        <ui:Card Padding="12">
                            <StackPanel>
                                <TextBlock Text="阴影设置" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="阴影：" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch x:Name="ShadowEnabledToggle" Grid.Column="1"
                                                     Content="启用阴影"
                                                     Checked="OnShadowToggled" Unchecked="OnShadowToggled" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="不透明度：" VerticalAlignment="Center" />
                                    <Slider x:Name="ShadowOpacitySlider" Grid.Column="1"
                                            Minimum="0.0" Maximum="1.0" TickFrequency="0.05"
                                            ValueChanged="OnDanmakuPreviewChanged"
                                            IsEnabled="{Binding IsChecked, ElementName=ShadowEnabledToggle}" />
                                    <TextBlock x:Name="ShadowOpacityLabel" Grid.Column="2"
                                               Text="0.60" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="偏移量：" VerticalAlignment="Center" />
                                    <Slider x:Name="ShadowOffsetSlider" Grid.Column="1"
                                            Minimum="0.0" Maximum="8.0" TickFrequency="0.5"
                                            ValueChanged="OnDanmakuPreviewChanged"
                                            IsEnabled="{Binding IsChecked, ElementName=ShadowEnabledToggle}" />
                                    <TextBlock x:Name="ShadowOffsetLabel" Grid.Column="2"
                                               Text="2.0" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- 鼠标悬停设置 -->
                        <ui:Card Padding="12">
                            <StackPanel>
                                <TextBlock Text="鼠标悬停设置" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="悬停隐藏：" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch x:Name="HoverHideToggle" Grid.Column="1"
                                                     Content="鼠标移到弹幕上时隐藏该弹幕" />
                                </Grid>
                                <TextBlock Text="提示：覆盖层默认穿透鼠标事件，通过系统级鼠标坐标检测实现。"
                                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="11" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 4: 醒目留言 ── -->
            <TabItem Header="醒目留言">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <ui:Card Padding="12">
                            <StackPanel>
                                <TextBlock Text="醒目留言设置" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="字号：" VerticalAlignment="Center" />
                                    <Slider x:Name="ScFontSizeSlider" Grid.Column="1"
                                            Minimum="24" Maximum="72" TickFrequency="2"
                                            ValueChanged="OnDanmakuPreviewChanged" />
                                    <TextBlock x:Name="ScFontSizeLabel" Grid.Column="2"
                                               Text="40" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="持续：" VerticalAlignment="Center" />
                                    <Slider x:Name="ScDurationSlider" Grid.Column="1"
                                            Minimum="5000" Maximum="30000" TickFrequency="500"
                                            ValueChanged="OnDanmakuPreviewChanged" />
                                    <TextBlock x:Name="ScDurationLabel" Grid.Column="2"
                                               Text="15000 ms" TextAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Tab 5: 日志 ── -->
            <TabItem Header="日志">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="日志" FontSize="12"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <ui:ToggleSwitch Grid.Column="1" x:Name="AutoScrollToggle"
                                         Content="自动滚动" IsChecked="True"
                                         Margin="0,0,8,0" />
                        <ui:Button Grid.Column="2" Content="清除" Icon="{ui:SymbolIcon Delete24}"
                                   Click="OnClearLog" FontSize="11" />
                        <ui:Button Grid.Column="3" Content="复制" Icon="{ui:SymbolIcon Copy24}"
                                   Click="OnCopyLog" FontSize="11" Margin="4,0,0,0" />
                    </Grid>

                    <TextBox x:Name="LogBox" Grid.Row="1"
                             IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                             Background="{ui:ThemeResource ControlFillColorInputActiveBrush}"
                             Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" AcceptsReturn="True" />
                </Grid>
            </TabItem>

            <!-- ── Tab 6: 关于 ── -->
            <TabItem Header="关于">
                <StackPanel Margin="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:Card Padding="24" Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="BLivedm Notification" FontSize="20" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="B站直播间弹幕叠加层" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                            <Separator Margin="0,12" />
                            <TextBlock Text="Python 后端 + C# WPF 前端" HorizontalAlignment="Center" />
                            <TextBlock Text="双进程架构 · Named Pipe IPC · DrawingVisual 渲染"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <Separator Margin="0,12" />
                            <TextBlock Text="WPF Overlay (替代 WinUI)" FontSize="12"
                                       Foreground="{ui:ThemeResource TextFillColorDisabledBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </TabItem>
        </TabControl>

        <!-- ══════════ Status Bar ══════════ -->
        <Border Grid.Row="2" Padding="8,4"
                BorderThickness="0,1,0,0"
                BorderBrush="{ui:ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ui:ThemeResource ControlFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="BackendStatus" FontSize="14" VerticalAlignment="Center">○ 后端</TextBlock>
                <ui:Button x:Name="StartBackendBtn" Content="启动后端" Icon="{ui:SymbolIcon Play24}"
                           Click="OnStartBackend" Margin="6,0" />
                <ui:Button x:Name="StopBackendBtn" Content="停止后端" Icon="{ui:SymbolIcon Stop24}"
                           Click="OnStopBackend" Margin="0,0,12,0" IsEnabled="False"
                           Appearance="Danger" />

                <TextBlock x:Name="OverlayStatus" FontSize="14" VerticalAlignment="Center">○ 覆盖层</TextBlock>
                <ui:Button x:Name="ShowOverlayBtn" Content="显示" Icon="{ui:SymbolIcon Eye24}"
                           Click="OnShowOverlay" Margin="6,0" />
                <ui:Button x:Name="HideOverlayBtn" Content="隐藏" Icon="{ui:SymbolIcon EyeOff24}"
                           Click="OnHideOverlay" Margin="0,0,12,0" IsEnabled="False" />

                <ui:Button x:Name="StartAllBtn" Content="全部启动" Icon="{ui:SymbolIcon Play24}"
                           Click="OnStartAll" Margin="6,0" Appearance="Primary" />
                <ui:Button x:Name="StopAllBtn" Content="全部停止" Icon="{ui:SymbolIcon Stop24}"
                           Click="OnStopAll" IsEnabled="False" Appearance="Danger" />
            </StackPanel>
        </Border>

    </Grid>
</ui:FluentWindow>

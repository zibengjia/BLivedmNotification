<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Overlay.Pages.SuperChatSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer AutomationProperties.AutomationId="SuperChatSettingsPage">
        <StackPanel Padding="24,16" Spacing="0">

            <!-- Page header -->
            <TextBlock Text="醒目留言"
                Style="{StaticResource TitleTextBlockStyle}"
                AutomationProperties.AutomationId="PageTitle" />

            <!-- InfoBar -->
            <InfoBar x:Name="ScInfo"
                IsOpen="True"
                Severity="Informational"
                Message="醒目留言 (Super Chat) 是观众付费发送的置顶消息。停留时间结束后将在最后 2 秒淡出。"
                IsClosable="False"
                Margin="0,16,0,0"
                AutomationProperties.AutomationId="ScInfo" />

            <!-- ─── 醒目留言参数 ─── -->
            <TextBlock Text="显示参数"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,24,0,0" />

            <Grid Margin="0,16,0,0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Font Size -->
                <Grid Grid.Row="0" ColumnDefinitions="120,*">
                    <TextBlock Text="字号"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <NumberBox x:Name="NudScFontSize" Grid.Column="1"
                        Minimum="12" Maximum="120"
                        SpinButtonPlacementMode="Inline"
                        SmallChange="1" LargeChange="10"
                        ValidationMode="InvalidInputOverwritten"
                        Value="40"
                        AutomationProperties.AutomationId="NudScFontSize"
                        AutomationProperties.Name="醒目留言字号" />
                </Grid>

                <!-- Duration -->
                <Grid Grid.Row="1" ColumnDefinitions="120,*">
                    <TextBlock Text="停留时间 (ms)"
                        VerticalAlignment="Center"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <NumberBox x:Name="NudScDuration" Grid.Column="1"
                        Minimum="1000" Maximum="120000"
                        SpinButtonPlacementMode="Inline"
                        SmallChange="1000" LargeChange="5000"
                        ValidationMode="InvalidInputOverwritten"
                        Value="15000"
                        AutomationProperties.AutomationId="NudScDuration"
                        AutomationProperties.Name="醒目留言停留时间毫秒" />
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>

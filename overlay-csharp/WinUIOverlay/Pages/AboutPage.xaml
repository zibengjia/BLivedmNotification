<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Overlay.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer AutomationProperties.AutomationId="AboutPage">
        <StackPanel Padding="24,16" Spacing="0">

            <!-- Page header -->
            <TextBlock Text="关于"
                Style="{StaticResource TitleTextBlockStyle}"
                AutomationProperties.AutomationId="PageTitle" />

            <!-- App info -->
            <StackPanel Margin="0,24,0,0" Spacing="8">
                <TextBlock Text="BLivedm Notification"
                    Style="{StaticResource TitleLargeTextBlockStyle}" />

                <TextBlock Text="B站直播弹幕 Overlay"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <TextBlock Text="Python (blivedm) → Named Pipe → C# (WinUI 3 + Win2D)"
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Margin="0,4,0,0" />
            </StackPanel>

            <!-- Separator -->
            <Rectangle Height="1"
                Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="0,24,0,24" />

            <!-- Usage -->
            <TextBlock Text="使用说明"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Margin="0,0,0,12" />

            <StackPanel Spacing="8" Margin="0,0,0,0">
                <Grid ColumnDefinitions="24,*">
                    <TextBlock Text="1." Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="填写直播间 ID 和 SESSDATA（可选）"
                        Style="{ThemeResource BodyTextBlockStyle}" />
                </Grid>
                <Grid ColumnDefinitions="24,*">
                    <TextBlock Text="2." Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="点击「全部启动」或分别启动后端和叠加层"
                        Style="{ThemeResource BodyTextBlockStyle}" />
                </Grid>
                <Grid ColumnDefinitions="24,*">
                    <TextBlock Text="3." Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock Grid.Column="1" Text="叠加层中按 ESC 返回配置界面"
                        Style="{ThemeResource BodyTextBlockStyle}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>

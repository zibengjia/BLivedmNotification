<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Overlay.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Navigation -->
        <NavigationView x:Name="NavView"
            PaneDisplayMode="LeftCompact"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged"
            AutomationProperties.Name="配置导航"
            Header="BLivedm Notification">

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="basic" IsSelected="True"
                    AutomationProperties.AutomationId="NavBasic">
                    <NavigationViewItem.Content>基本设置</NavigationViewItem.Content>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="danmaku"
                    AutomationProperties.AutomationId="NavDanmaku">
                    <NavigationViewItem.Content>弹幕设置</NavigationViewItem.Content>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8BD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="superchat"
                    AutomationProperties.AutomationId="NavSuperChat">
                    <NavigationViewItem.Content>醒目留言</NavigationViewItem.Content>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="about"
                    AutomationProperties.AutomationId="NavAbout">
                    <NavigationViewItem.Content>关于</NavigationViewItem.Content>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="log"
                    AutomationProperties.AutomationId="NavLog">
                    <NavigationViewItem.Content>日志</NavigationViewItem.Content>
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8ED;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <Button x:Name="BtnSaveConfig"
                    Content="保存配置"
                    Click="OnSaveConfig"
                    AutomationProperties.AutomationId="BtnSaveConfig"
                    Margin="8,0,8,12" />
            </NavigationView.PaneFooter>

            <ContentControl x:Name="PageContainer" />
        </NavigationView>

        <!-- Bottom Status Panel -->
        <Border Grid.Row="1"
            Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}">
            <Grid Padding="16,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Status indicators -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <!-- Backend status -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="BackendDot" Width="10" Height="10"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="BackendStatusDot" />
                        <TextBlock x:Name="LblBackend" Text="后端: 已停止"
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <!-- Overlay status -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="OverlayDot" Width="10" Height="10"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="OverlayStatusDot" />
                        <TextBlock x:Name="LblOverlay" Text="叠加层: 已隐藏"
                            VerticalAlignment="Center"
                            Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- Spacer -->
                <ContentControl Grid.Column="1" />

                <!-- Control buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="BtnBackend"
                        Content="启动后端"
                        Click="OnToggleBackend"
                        AutomationProperties.AutomationId="BtnToggleBackend" />
                    <Button x:Name="BtnOverlay"
                        Content="显示叠加层"
                        Click="OnToggleOverlay"
                        AutomationProperties.AutomationId="BtnToggleOverlay" />
                    <Button x:Name="BtnStartAll"
                        Content="全部启动"
                        Click="OnStartAll"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.AutomationId="BtnStartAll" />
                    <Button Content="全部停止"
                        Click="OnStopAll"
                        AutomationProperties.AutomationId="BtnStopAll" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
